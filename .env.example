# Local development & cloud configuration template
# Never commit real project IDs, tokens, or API keys — secrets load from Google Cloud Secret Manager.

# Gemini platform configuration (ADC)
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Strategic model routing tiers
SWIFTSHIP_FLASH_MODEL=gemini-3.8-flash
SWIFTSHIP_PRO_MODEL=gemini-3.1-pro-preview

# Persistent storage & vector search
SWIFTSHIP_BQ_DATASET=swiftship_ops
SWIFTSHIP_EMBED_LOCATION=us-central1

# Security, PII redaction, and secret management
SWIFTSHIP_SECRET_BACKEND=secretmanager
REMEDIATION_SIGNING_SECRET_ID=swiftship-remediation-signing-key
ENABLE_CLOUD_DLP=false
MODEL_ARMOR_LOCATION=us-central1
MODEL_ARMOR_TEMPLATE_ID=

# Observability & telemetry
OTEL_SERVICE_NAME=swiftship-ops-agent
ENABLE_CLOUD_TRACE=false
LOG_LEVEL=INFO
